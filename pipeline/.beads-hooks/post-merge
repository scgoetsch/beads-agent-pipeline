#!/usr/bin/env sh
# post-merge — shipped by beads-agent-pipeline. After a pull or a checkout, bring this clone's cairn store
# up to the tracked exports git brought in (workspace-7m8.21): `cairn sync` rebuilds a store that
# is behind them, builds one in a fresh clone, leaves one that is equal or ahead alone, and refuses
# when two clones both wrote. Its verdict goes to stderr; it never fails the git command. Git runs
# this hook from the top of the work tree; no .cairn/ means no store to sync.
if command -v cairn >/dev/null 2>&1 && [ -d .cairn ]; then
  cairn sync >&2 || :
fi
exit 0
