#!/usr/bin/env sh

# >>> store CLI >>>
# .claude/store-cli names the store's CLI: bd (absent: bd) or cairn, its replacement. The same
# rule as the session hooks (.claude/bd-prerun-hook.sh): tracked, one word, no environment
# override, an unknown value means bd. Git runs this hook from the top of the work tree.
STORE_CLI=bd
if [ -f .claude/store-cli ]; then
  case $(tr -d ' \t\r\n' < .claude/store-cli) in
    cairn) STORE_CLI=cairn ;;
    bd) ;;
    *) echo "⚠ .claude/store-cli is neither bd nor cairn — the pre-commit treats the store as bd's" >&2 ;;
  esac
fi
# <<< store CLI <<<

# >>> bd-memgraph check >>>
# Blocks commits on hard memory-graph errors (dangling/self links); warnings pass.
# Skips silently when bd, bd-memgraph, or .beads are absent — never bricks a repo.
# Bypass once with: git commit --no-verify   Remove with: bd-memgraph install-hook --remove
if command -v bd-memgraph >/dev/null 2>&1 && command -v "$STORE_CLI" >/dev/null 2>&1 && [ -d .beads ]; then
  # --no-ledger: the guard validates only — writing observations mid-commit would
  # dirty .beads/memgraph-ledger.json in the working tree on every commit
  if [ "$STORE_CLI" = cairn ]; then
    # bd-memgraph reads `bd memories --json` by itself; cairn's is the same map, given as a file.
    _mg_json=$(mktemp) || exit 1
    if cairn memories --json > "$_mg_json"; then
      bd-memgraph --no-ledger --json-file "$_mg_json" check; _mg_rc=$?
    else
      echo "bd-memgraph: \`cairn memories --json\` failed — the memory graph was NOT checked" >&2; _mg_rc=0
    fi
    rm -f "$_mg_json"
  else
    bd-memgraph --no-ledger check; _mg_rc=$?
  fi
  [ "$_mg_rc" -eq 0 ] || {
    echo "bd-memgraph: hard errors in the memory graph (see above) — fix or --no-verify" >&2
    exit 1
  }
fi
# <<< bd-memgraph check <<<


# >>> agent-cache path guard >>>
# Rejects committed files embedding a per-conversation agent cache path (agy/antigravity
# brain/, Claude Code projects/, /tmp/claude-<uid>/). Enforced HERE, at the git layer,
# because session hooks are harness-specific and this trap is not: every agent and every
# human passes through `git commit`. Logic lives in the repo so it is reviewable.
# Bypass once with: git commit --no-verify
if [ -x tools/check-no-agent-cache-paths.sh ]; then
  tools/check-no-agent-cache-paths.sh || exit 1
fi
# <<< agent-cache path guard <<<


# >>> agent-docs symlink guard >>>
# CLAUDE.md must stay a symlink to AGENTS.md so the two cannot diverge, and the
# workspace protocol must stay outside the bd-managed markers. Logic lives in the
# repo so it is reviewable; this stanza is only the invocation.
# Bypass once with: git commit --no-verify   Reinstall: re-run beads-agent-pipeline's install.sh
if [ -x tools/check-agent-docs-linked.sh ]; then
  tools/check-agent-docs-linked.sh --cached || exit 1
fi
# <<< agent-docs symlink guard <<<

# >>> store CLI: cairn stops here >>>
# Everything below is bd's managed block (`bd hooks run pre-commit`). With cairn as the store's CLI
# bd's store is frozen, and a bd call on every commit is exactly what the move retires. This
# stanza sits ABOVE bd's markers so `bd hooks install` cannot remove it.
[ "$STORE_CLI" = cairn ] && exit 0
# <<< store CLI: cairn stops here <<<

# --- BEGIN BEADS INTEGRATION v1.1.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.1.2 ---
