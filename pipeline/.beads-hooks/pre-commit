#!/usr/bin/env sh
# pre-commit — shipped by beads-agent-pipeline. Git runs this hook from the top of the work tree.
# Four independent stanzas; the installer verifies each by its marker. Bypass once with
# `git commit --no-verify`. Reinstall: re-run beads-agent-pipeline's install.sh.

# >>> store check >>>
# Blocks commits on hard store errors: `cairn check` covers the memory links (dangling or self
# links) and the store's own integrity (dangling dependencies, a second parent, a blocks cycle).
# Skips when cairn or the store (.cairn/) is absent; a check that cannot run is said, not failed.
if command -v cairn >/dev/null 2>&1 && [ -d .cairn ]; then
  cairn check; _sc_rc=$?
  if [ "$_sc_rc" -ge 2 ]; then
    echo "cairn check could not run (exit $_sc_rc) — the store was NOT checked" >&2; _sc_rc=0
  fi
  [ "$_sc_rc" -eq 0 ] || {
    echo "cairn check: errors in the store (see above) — fix or --no-verify" >&2
    exit 1
  }
fi
# <<< store check <<<


# >>> agent-cache path guard >>>
# Rejects committed files embedding a per-conversation agent cache path (agy/antigravity
# brain/, Claude Code projects/, /tmp/claude-<uid>/). Enforced HERE, at the git layer,
# because session hooks are harness-specific and this trap is not: every agent and every
# human passes through `git commit`. Logic lives in the repo so it is reviewable.
if [ -x tools/check-no-agent-cache-paths.sh ]; then
  tools/check-no-agent-cache-paths.sh || exit 1
fi
# <<< agent-cache path guard <<<


# >>> agent-docs symlink guard >>>
# CLAUDE.md must stay a symlink to AGENTS.md so the two cannot diverge. Logic lives in the
# repo so it is reviewable; this stanza is only the invocation.
if [ -x tools/check-agent-docs-linked.sh ]; then
  tools/check-agent-docs-linked.sh --cached || exit 1
fi
# <<< agent-docs symlink guard <<<


# >>> export freshness guard >>>
# The tracked exports in .cairn/ (issues.jsonl, memories.jsonl, allocator.json, events.jsonl) are
# the plain-text copy of the store that another clone rebuilds from, and nothing kept them current
# but a remembered manual export (39 issues of drift in two weeks, workspace-7m8.11). Blocks a
# commit whose STAGED exports differ from what cairn exports now, or whose events.jsonl does not
# extend the one in HEAD. A cairn that cannot run is not a stale export: the script exits 2, says
# the comparison did not happen, and the commit goes ahead.
if [ -x tools/refresh-beads-exports.sh ]; then
  tools/refresh-beads-exports.sh --cached
  if [ $? -eq 1 ]; then exit 1; fi
elif [ -e tools/refresh-beads-exports.sh ]; then
  echo "beads-exports: tools/refresh-beads-exports.sh is not executable — the tracked exports were NOT compared with the store." >&2
fi
# <<< export freshness guard <<<
